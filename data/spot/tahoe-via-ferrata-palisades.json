/alpenglowexpeditions.com/adventure/tahoe-via-ferrata","https://alpenglowexpeditions.com/blog/tahoe-via-ferrata-reopens-may-16"],"confidence":"medium","updated_at":"2026-11-05 16:00:18","activity":"viaferrata","activities":["viaferrata"],"attrs":{"grade_local":"Без официальной категории; оператор позиционирует как маршрут для новичков (2-часовой) – средний (4-часовой Skyline Traverse)","difficulty":2,"vertical_m":240,"top_m":2150,"elevation_m":1950,"duration_h":"2–4","approach_ru":"Сбор в деревне Олимпик-Вэлли, подъём к началу маршрута на вездеходе гидов «The Beast»","descent_ru":"С верха стены у опоры канатки Tram Tower 1 — короткая тропа и спуск на вездеходе; короткие варианты — кольцевые","features":["ladder","bridge","tibetan"],"kit_rental":true,"guide_price":{"eur":170,"year":2026,"note_ru":"Только с гидом Alpenglow Expeditions: 2 ч — $199–209, 3 ч — $230–251, 4 ч — $269–299 с человека (будни/выходные), снаряжение и трансфер включены"},"guide_price_eur":170,"fee":{"eur":null,"year":null,"note_ru":"Отдельной платы нет — только в составе тура"},"kids":true,"highlights_ru":"Гранитная стена высотой ~240 м прямо над курортом, тросовые мостики «Monkey in the Middle» и 15-метровый «Super Monkey Bridge», вид на долину и канатку"},"seasons":["off","off","off","off","shoulder","peak","peak","peak","peak","shoulder","off","off"],"seasons_by":{"viaferrata":["off","off","off","off","shoulder","peak","peak","peak","peak","shoulder","off","off"]},"climate":{"guide":[{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":4.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":5.0,"water_c":null,"wave_m":null,"rose":null,"swe