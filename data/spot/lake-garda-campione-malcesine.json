e.staticflickr.com/2589/3768634923_b02a456958_b.jpg","thumb":"https://api.openverse.org/v1/images/c0af5549-1a74-400c-81ff-159faaedc48d/thumb/","page":"https://www.flickr.com/photos/60327433@N00/3768634923","title":"abundant kite surfers","credit":"imnewtryme, CC BY-NC-SA 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":4,"label":"движуха","bars":25,"clubs":0,"restaurants":95,"cafes":38,"hotels":119,"radius_km":5,"ring":{"km":15,"bars":40,"clubs":0,"restaurants":206,"cafes":52,"hotels":193}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Подача через Almaviva / ItalyVMS с привязкой к региону прописки; сроки затягиваются до 60–70 дней. Мультивизы на 1–6 мес. иногда дают тем, у кого уже были визы после 2022. Сардиния и Сицилия — тоже Шенген.","source":"https://meduza.io/feature/2026/02/05/bolshoy-gid-po-shengenskim-vizam-dlya-rossiyan-kakie-strany-vydayut-ih-v-2026-m-gde-vyshe-shansy-poluchit-mozhno-li-esche-nadeyatsya-na-multivizu-i-kak-snizit-riski-otkaza","checked":"2026-10"}}