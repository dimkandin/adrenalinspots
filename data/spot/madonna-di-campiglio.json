рные дороги — зимняя резина и цепи","airport":"VRN — Верона, ~2,5 ч","links":{"skiresort_info":"https://www.skiresort.com/en/ski-resort/madonna-di-campiglio-pinzolo-folgarida-marilleva/","official":null,"other":["https://www.money.it/skipass-2026-2027-quanto-costa-sciare-quest-inverno"]},"sources":["https://www.skiresort.com/en/ski-resort/madonna-di-campiglio-pinzolo-folgarida-marilleva/","https://www.money.it/skipass-2026-2027-quanto-costa-sciare-quest-inverno","https://www.checkyeti.com/en/d/1151/8046"],"confidence":"medium","updated_at":"2026-11-03 19:41:27","activity":"snowboard","activities":["snowboard"],"attrs":{"base_m":852,"top_m":2504,"vertical_m":1652,"pistes_km":155.0,"easy_km":50.0,"medium_km":72.0,"hard_km":33.0,"lifts":58,"season_ru":"конец ноября — середина апреля (2026/27: 21.11–11.04)","glacier":false,"summer_ski":false,"snowmaking":"most","snowpark":"good","freeride":3,"heliski":false,"beginner":4,"apres":3,"lift_pass":{"price":87.0,"currency":"EUR","season":"2026/27","note_ru":"1 день, взрослый, Skiarea Campiglio (Мадонна, Пинцоло, Фольгарида, Марилева), высокий сезон; в пиковые даты — 89 €. skiresort.com указывает 85 € (вероятно, 2025/26)"},"lift_pass_eur":87.0,"transfer_ru":"Верона ~2,5 ч, Милан-Бергамо ~3 ч, Инсбрук ~3 ч; поездом до Тренто, далее автобус ~1,5 ч"},"seasons":["peak","peak","peak","shoulder","off","off","off","off","off","off","shoulder","peak"],"seasons_by":{"snowboard":["peak","peak","peak","shoulder","off","off","off","off","off","off","shoulder","peak"]},"climate":{"guide":[{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":-5.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":90.0,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":nu