27397_b.jpg","thumb":"https://api.openverse.org/v1/images/30806a72-a5ca-4554-8c74-86dd76a450b3/thumb/","page":"https://www.flickr.com/photos/39891373@N07/3665461441","title":"Scuba diving Indonesia - Bali - Komodo - Bunaken 2008","credit":"Ilse Reijs and Jan-Noud Hutten, CC BY 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3401/3666272244_a330c3d7e9_b.jpg","thumb":"https://api.openverse.org/v1/images/6ce55ee1-df4b-43b0-89d1-82c278816048/thumb/","page":"https://www.flickr.com/photos/39891373@N07/3666272244","title":"Scuba diving Indonesia - Bali - Komodo - Bunaken 2008","credit":"Ilse Reijs and Jan-Noud Hutten, CC BY 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2612/3665462673_b0bf12fa39_b.jpg","thumb":"https://api.openverse.org/v1/images/2389c854-6a0e-4e63-a50d-63cf122747ae/thumb/","page":"https://www.flickr.com/photos/39891373@N07/3665462673","title":"Scuba diving Indonesia - Bali - Komodo - Bunaken 2008","credit":"Ilse Reijs and Jan-Noud Hutten, CC BY 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":2,"label":"тихо","bars":5,"clubs":0,"restaurants":4,"cafes":1,"hotels":25,"radius_km":5,"ring":{"km":15,"bars":0,"clubs":0,"restaurants":11,"cafes":2,"hotels":19}},"videos":[],"visa":{"status":"visa_on_arrival","label":"Виза по прибытии / e-VOA (500 000 IDR)","stay_days":30,"difficulty":2,"notes":"Виза по прибытии или e-VOA заранее — 500 000 рупий (~$35), 30 дней, однократно продлевается ещё на 30 (всего 60). Паспорт 6+ мес., обратный билет. Заранее заполнить электронную карту прибытия All Indonesia; на Бали — туристический сбор 150 000 IDR.","source":"https://t-j.ru/guide/no-visa-countries/","checked":"2026-10"}}