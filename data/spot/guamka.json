пинг «Гагарин», базовый лагерь ФСР у реки Курджипс, гостиницы и гостевые дома в хуторе («Гуамка», «Большая Медведица», «Ореховая роща»); термальные бассейны в Володее в 7 км","transfer_ru":"Самолётом или поездом до Краснодара (~156 км, ~3 ч на машине через Апшеронск); автобус Апшеронск — Гуамка 2 раза в день"},"seasons":["off","off","off","shoulder","shoulder","shoulder","peak","peak","peak","peak","shoulder","off"],"seasons_by":{"climbing":["off","off","off","shoulder","shoulder","shoulder","peak","peak","peak","peak","shoulder","off"]},"climate":{"guide":[{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":5.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":6.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":11.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":17.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":nul