. Уточнять действующие ограничения воздушного пространства на юге России","landing_ru":"Посадочное плато на западной стороне и поля у подножия и посёлка Юца (~690 м) — большие и простые","events_ru":"Чемпионат России по парапланерному спорту 2017 (Pre-PWC), Открытое первенство России среди юниоров 2018, Чемпионат России 2018, Кубок России по дельтапланеризму 2017","season_ru":"Термический сезон со второй половины марта по октябрь; тандемы и парение — почти круглый год в хорошую погоду","transfer_ru":"Аэропорт Минеральные Воды ~40 минут; от Пятигорска ~20–30 минут; автобус до посёлка Юца"},"seasons":["shoulder","shoulder","shoulder","peak","peak","peak","peak","peak","peak","peak","shoulder","shoulder"],"seasons_by":{"paragliding":["shoulder","shoulder","shoulder","peak","peak","peak","peak","peak","peak","peak","shoulder","shoulder"]},"climate":{"guide":[{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":1.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":2.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":8.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,