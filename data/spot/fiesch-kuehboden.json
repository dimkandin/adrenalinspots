ive.staticflickr.com/3289/2797347288_3996ddbd5a_b.jpg","thumb":"https://api.openverse.org/v1/images/c67bc328-5115-40a2-b097-f6fc332f1211/thumb/","page":"https://www.flickr.com/photos/85864219@N00/2797347288","title":"CS Fiesch 21-24.08.2008 133","credit":"Vosti Claudio, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/208/453543943_f9c3c46071_b.jpg","thumb":"https://api.openverse.org/v1/images/bb1a95c2-380f-4608-a1b9-d2aa74f463b7/thumb/","page":"https://www.flickr.com/photos/12388159@N00/453543943","title":"20070409_startplatz_kühboden.jpg","credit":"christian st., CC BY-NC-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3205/2866794412_398f0e0dd9_b.jpg","thumb":"https://api.openverse.org/v1/images/777597ac-8505-4cec-9b26-010d6783957f/thumb/","page":"https://www.flickr.com/photos/14417041@N07/2866794412","title":"Where the glacier melts","credit":"TraitorFrog, CC BY-NC-ND 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":3,"label":"есть жизнь","bars":10,"clubs":0,"restaurants":36,"cafes":5,"hotels":35,"radius_km":5,"ring":{"km":15,"bars":14,"clubs":1,"restaurants":113,"cafes":14,"hotels":44}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Не член ЕС, но в Шенгене. Подача через VFS Global (Москва, СПб, Екатеринбург, Новосибирск, Ростов-на-Дону), рассмотрение до 3 недель (летом 2026 — около 2), в основном однократные визы под даты; сервисный сбор ~2 079 ₽. Бронь жилья должна быть оплачена и подтверждена напрямую отелем.","source":"https://t-j.ru/switzerland-tourist-visa/","checked":"2026-10"}}