_a4741afdff_b.jpg","thumb":"https://api.openverse.org/v1/images/db61f58b-82d9-47b3-b907-9473b4f3cd8b/thumb/","page":"https://www.flickr.com/photos/32759463@N08/25759197468","title":"The dolphin","credit":"Paulo Etxeberria, CC BY-NC-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2149/2774988401_5042938d45_b.jpg","thumb":"https://api.openverse.org/v1/images/baaaccc8-c88a-4a5e-8a79-5a2d8f4cc37d/thumb/","page":"https://www.flickr.com/photos/96605242@N00/2774988401","title":"The dolphin","credit":"miquelsi, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3204/2660368767_ced078df20_b.jpg","thumb":"https://api.openverse.org/v1/images/e2804566-8ce4-4aca-86dd-ade7c7f18ba4/thumb/","page":"https://www.flickr.com/photos/77807177@N00/2660368767","title":"An arch in the Rodellar climbing area","credit":"s_mestdagh, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3045/3019118046_57b570a652_b.jpg","thumb":"https://api.openverse.org/v1/images/28fb47bd-6edb-40e1-9de1-55794125cd4a/thumb/","page":"https://www.flickr.com/photos/13935267@N00/3019118046","title":"Faaaallliing","credit":"Damien Ayers, CC BY 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2932/14563834783_ef858b70c2_b.jpg","thumb":"https://api.openverse.org/v1/images/6689e481-efab-4d6e-bfd4-d1caed4a0084/thumb/","page":"https://www.flickr.com/photos/94079659@N00/14563834783","title":"DSC_7382","credit":"Chunchi, CC BY-NC-ND 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":2,"label":"тихо","bars":2,"clubs":0,"restaurants":4,"cafes":0,"hotels":1,"radius_km":5,"ring":{"km":15,"bars":5,"clubs":0,"restaurants":14,"cafes":4,"hotels":18}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Визовые центры BLS Spain с привязкой к прописке (Северо-Запад или Москва для остальной РФ), рассмотрение 15–30 дней, обычно виза на ~1 месяц. С 12.07.2025 россиянам нужна транзитная виза даже для пересадки в аэропортах Испании (важно для рейсов в Латинскую Америку через Мадрид). Канары — тоже Шенген.","source":"https://www.exteriores.gob.es/Consulados/moscu/ru/Comunicacion/Noticias/Paginas/Articulos/20250616_NOT1.aspx","checked":"2026-10"}}