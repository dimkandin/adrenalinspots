c_b.jpg","thumb":"https://api.openverse.org/v1/images/3e52f9d9-5cb2-4c1c-a935-d2d17b126b7a/thumb/","page":"https://www.flickr.com/photos/84568497@N08/9401364936","title":"bouldercup frankenjura blockhelden erlangenalbum 20120167","credit":"BLOCKHELDEN, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2888/9398596947_99157b0a4b_b.jpg","thumb":"https://api.openverse.org/v1/images/e3cf6168-fd08-40cc-97c8-3b52c11580a8/thumb/","page":"https://www.flickr.com/photos/84568497@N08/9398596947","title":"bouldercup frankenjura blockhelden erlangenalbum 20120156","credit":"BLOCKHELDEN, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3803/9398601203_0bf9c71a98_b.jpg","thumb":"https://api.openverse.org/v1/images/6446eb37-05fa-47bf-a32d-e0f6002bd539/thumb/","page":"https://www.flickr.com/photos/84568497@N08/9398601203","title":"bouldercup frankenjura blockhelden erlangenalbum 20120174","credit":"BLOCKHELDEN, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2822/9398597847_0b767e1d8a_b.jpg","thumb":"https://api.openverse.org/v1/images/33164f68-236e-44f2-ac20-75740f99ff45/thumb/","page":"https://www.flickr.com/photos/84568497@N08/9398597847","title":"bouldercup frankenjura blockhelden erlangenalbum 20120160","credit":"BLOCKHELDEN, CC BY-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2877/9401364288_b2056e6914_b.jpg","thumb":"https://api.openverse.org/v1/images/a79107dd-9a0f-42cc-84f9-f5f6f536d528/thumb/","page":"https://www.flickr.com/photos/84568497@N08/9401364288","title":"bouldercup frankenjura blockhelden erlangenalbum 20120165","credit":"BLOCKHELDEN, CC BY-SA 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":3,"label":"есть жизнь","bars":1,"clubs":0,"restaurants":18,"cafes":2,"hotels":9,"radius_km":5,"ring":{"km":15,"bars":53,"clubs":0,"restaurants":198,"cafes":46,"hotels":7