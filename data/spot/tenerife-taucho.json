n_Canary_Islands_-_football_sports_bar_in_Tenerife.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumb":null,"page":"https://commons.wikimedia.org/wiki/File:003_British_small_business_in_Canary_Islands_-_football_sports_bar_in_Tenerife.jpg","title":"003 British small business in Canary Islands - football sports bar in Tenerife.jpg","credit":"Marek Ślusarczyk (Tupungato) Photo portfolio, CC BY 3.0, Wikimedia Commons","source":"commons"}],"vibe":{"score":4,"label":"движуха","bars":25,"clubs":0,"restaurants":69,"cafes":19,"hotels":24,"radius_km":5,"ring":{"km":15,"bars":251,"clubs":17,"restaurants":729,"cafes":161,"hotels":252}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Визовые центры BLS Spain с привязкой к прописке (Северо-Запад или Москва для остальной РФ), рассмотрение 15–30 дней, обычно виза на ~1 месяц. С 12.07.2025 россиянам нужна транзитная виза даже для пересадки в аэропортах Испании (важно для рейсов в Латинскую Америку через Мадрид). Канары — тоже Шенген.","source":"https://www.exteriores.gob.es/Consulados/moscu/ru/Comunicacion/Noticias/Paginas/Articulos/20250616_NOT1.aspx","checked":"2026-10"}}