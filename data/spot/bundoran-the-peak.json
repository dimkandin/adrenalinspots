c11_b.jpg","thumb":"https://api.openverse.org/v1/images/ad7b7c5c-ae16-4f6b-912c-4c2d100afd57/thumb/","page":"https://www.flickr.com/photos/38907854@N00/5100399892","title":"Ireland","credit":"ciccio (°°), CC BY-NC-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/3544/3501624644_329769136c_b.jpg","thumb":"https://api.openverse.org/v1/images/82b29a80-cfe5-4c38-91a2-701b13330879/thumb/","page":"https://www.flickr.com/photos/13913405@N00/3501624644","title":"Gladiators at the peak","credit":"fintbo, CC BY-NC-ND 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2514/4023413878_460e867a31_b.jpg","thumb":"https://api.openverse.org/v1/images/db32ab0d-ccc1-4c00-9695-d643612668c2/thumb/","page":"https://www.flickr.com/photos/13913405@N00/4023413878","title":"The Peak was firing.. and crowded","credit":"fintbo, CC BY-NC-ND 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2560/4022656101_8f0cd47b1c_b.jpg","thumb":"https://api.openverse.org/v1/images/91196731-6546-4470-94c1-13e23bbab3bb/thumb/","page":"https://www.flickr.com/photos/13913405@N00/4022656101","title":"The Peak","credit":"fintbo, CC BY-NC-ND 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2461/4022657251_30f5187f8a_b.jpg","thumb":"https://api.openverse.org/v1/images/08a79850-26fb-4bc1-a858-81aaa921874e/thumb/","page":"https://www.flickr.com/photos/13913405@N00/4022657251","title":"Long Left on the Peak","credit":"fintbo, CC BY-NC-ND 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":3,"label":"есть жизнь","bars":11,"clubs":1,"restaurants":15,"cafes":7,"hotels":19,"radius_km":5,"ring":{"km":15,"bars":20,"clubs":0,"restaurants":13,"cafes":8,"hotels":13}},"videos":[],"visa":{"status":"visa_hard","label":"Национальная виза Ирландии","stay_days":90,"difficulty":4,"notes":"Ирландия не в Шенгене: шенгенская виза не действует, нужна отдельная ирландс