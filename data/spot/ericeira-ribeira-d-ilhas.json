/thumb/","page":"https://www.flickr.com/photos/74711243@N06/24313168028","title":"SM1_1595","credit":"Web Summit, CC BY 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/4542/38110500716_fff38ca141_b.jpg","thumb":"https://api.openverse.org/v1/images/438d8390-6448-4c95-b18c-781d2e877f59/thumb/","page":"https://www.flickr.com/photos/74711243@N06/38110500716","title":"SM0_9775","credit":"Web Summit, CC BY 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/4546/26389144869_0172a18340_b.jpg","thumb":"https://api.openverse.org/v1/images/2bb09d3e-f649-4b10-81f5-3370c6f35075/thumb/","page":"https://www.flickr.com/photos/74711243@N06/26389144869","title":"SM1_1613","credit":"Web Summit, CC BY 2.0, flickr","source":"openverse"}],"vibe_photos":[],"vibe":{"score":4,"label":"движуха","bars":3,"clubs":1,"restaurants":97,"cafes":36,"hotels":33,"radius_km":5,"ring":{"km":15,"bars":5,"clubs":0,"restaurants":68,"cafes":63,"hotels":6}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Подача через BLS International (Москва, СПб, Екатеринбург, Самара и др.); слоты открываются ~20-го числа и быстро разбираются; фактическое ожидание решения 70–90 дней и больше. В основном однократные визы под даты. Мадейра и Азоры — тоже Шенген.","source":"https://t-j.ru/portugal-tourist-visa/","checked":"2026-10"}}