-4630-a429-de55b8473280/thumb/","page":"https://www.flickr.com/photos/23222299@N00/26130961054","title":"","credit":"PhantomClickr, CC BY-NC 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/1220/3164599812_7113027cb6_b.jpg","thumb":"https://api.openverse.org/v1/images/77358ac9-4cf5-4ad7-bb3a-6a2ca52d698e/thumb/","page":"https://www.flickr.com/photos/94791345@N00/3164599812","title":"Sem título","credit":"William Kitzinger, CC BY-NC-SA 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/1074/3163767067_13f2bd8054_b.jpg","thumb":"https://api.openverse.org/v1/images/9221f965-11c6-4a47-977b-38345d30fdd6/thumb/","page":"https://www.flickr.com/photos/94791345@N00/3163767067","title":"Sem título","credit":"William Kitzinger, CC BY-NC-SA 2.0, flickr","source":"openverse"}],"vibe_photos":[{"kind":"vibe","url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Bar_Luiz.jpg/1280px-Bar_Luiz.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumb":null,"page":"https://commons.wikimedia.org/wiki/File:Bar_Luiz.jpg","title":"Bar Luiz.jpg","credit":"Rodrigo do Val Ferreira, CC BY 2.0, Wikimedia Commons","source":"commons"},{"kind":"vibe","url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Bar_Luiz_-_Interior.jpg/1280px-Bar_Luiz_-_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumb":null,"page":"https://commons.wikimedia.org/wiki/File:Bar_Luiz_-_Interior.jpg","title":"Bar Luiz - Interior.jpg","credit":"Monica Kaneko, CC BY-SA 2.0, Wikimedia Commons","source":"commons"}],"vibe":{"score":5,"label":"тусовка","bars":297,"clubs":12,"restaurants":803,"cafes":136,"hotels":244,"radius_km":5,"ring":{"km":15,"bars":461,"clubs":15,"restaurants":1383,"cafes":192,"hotels":141}},"videos":[],"visa":{"status":"no_visa","label":"Без визы до 90 дней","stay_days":90,"difficulty":1,"notes":"До 90 дней в 180 (продлевается на месте е