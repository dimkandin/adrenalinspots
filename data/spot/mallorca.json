lickr.com/photos/82263310@N00/7907820186","title":"winery I","credit":"mrtnski - climb with mind, CC BY-NC-ND 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/2746/4363009984_d34d3bf38e_b.jpg","thumb":"https://api.openverse.org/v1/images/094310f9-b037-43f6-bc4a-917f1ce589e2/thumb/","page":"https://www.flickr.com/photos/33465428@N02/4363009984","title":"LTU Lockheed L1011 Tristar","credit":"Deanster1983 who's on and off, CC BY-ND 2.0, flickr","source":"openverse"},{"kind":"photo","url":"https://live.staticflickr.com/8036/7907818210_203ef95264_b.jpg","thumb":"https://api.openverse.org/v1/images/4457917a-8b99-4020-adde-e1215e6b5938/thumb/","page":"https://www.flickr.com/photos/82263310@N00/7907818210","title":"Cala Barques","credit":"mrtnski - climb with mind, CC BY-NC-ND 2.0, flickr","source":"openverse"}],"vibe_photos":[{"kind":"vibe","url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Men_outside_Cafe_-_Palma_de_Mallorca_-_Mallorca_-_Spain_%2814480698714%29.jpg/1280px-Men_outside_Cafe_-_Palma_de_Mallorca_-_Mallorca_-_Spain_%2814480698714%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumb":null,"page":"https://commons.wikimedia.org/wiki/File:Men_outside_Cafe_-_Palma_de_Mallorca_-_Mallorca_-_Spain_(14480698714).jpg","title":"Men outside Cafe - Palma de Mallorca - Mallorca - Spain (14480698714).jpg","credit":"Adam Jones from Kelowna, BC, Canada, CC BY-SA 2.0, Wikimedia Commons","source":"commons"}],"vibe":{"score":4,"label":"движуха","bars":23,"clubs":0,"restaurants":75,"cafes":38,"hotels":43,"radius_km":5,"ring":{"km":15,"bars":58,"clubs":1,"restaurants":205,"cafes":117,"hotels":157}},"videos":[],"visa":{"status":"visa_hard","label":"Шенгенская виза","stay_days":90,"difficulty":4,"notes":"Шенген: сбор €90, страховка от €30 000, рассмотрение офиц. до 45 дней (на практике 2–10 недель); с ноября 2025 ЕС почти не выдаёт россиянам мультивизы — в основном однократные визы под даты поездки; с апреля 2026 полностью работает EES (биометрия на границе). Визовые центры BLS Spain с привязкой к прописке (Северо-Запад или Москва для остальной РФ), рассмотрение 15–30 дней, обычно виза на ~1 месяц. С 12.07.2025 россиянам нужна транзитная виза даже для пересадки в аэропортах Испании (важно для рейсов в Латинскую Америку через Мадрид). Канары — тоже Шенген.","source":"https://www.exteriores.gob.es/Consulados/moscu/ru/Comunicacion/Noticias/Paginas/Articulos/20250616_NOT1.aspx","checked":"2026-10"}}