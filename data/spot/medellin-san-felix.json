я из-за воздушного движения над Медельином","rules_ru":"Из-за воздушного движения (аэропорт Медельина) нельзя улетать на восток за установленные границы; перед полётом смотреть прогноз SIATA","landing_ru":"Верхняя посадка у старта (удобная) и нижняя посадка Эль-Трапиче в Белло (~1450 м); на нижней посадке не рекомендуют оставаться в сумерках — район небезопасен","season_ru":"Летают круглый год; суше и стабильнее декабрь — март и июнь — июль; апрель — май и октябрь — ноябрь — дожди; в августе — сентябре сильный ветер, летают утром и вечером","transfer_ru":"Из аэропорта Медельина (Рионегро) ~1–1,5 ч; из центра Медельина ~45 минут"},"seasons":["peak","peak","peak","shoulder","shoulder","peak","peak","shoulder","shoulder","shoulder","shoulder","peak"],"seasons_by":{"paragliding":["peak","peak","peak","shoulder","shoulder","peak","peak","shoulder","shoulder","shoulder","shoulder","peak"]},"climate":{"guide":[{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":28.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":28.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_c":null,"sun_h":null,"rain_days":null,"hum_pct":null,"dry_prob":null,"fly_prob":null,"cloudbase_m":null},{"wind_kn":null,"wind_prob":null,"gust_kn":null,"gust_factor":null,"air_c":28.0,"water_c":null,"wave_m":null,"rose":null,"swell_m":null,"swell_s":null,"surf_prob":null,"tide_m":null,"clean_prob":null,"swell_rose":null,"snow_cm":null,"snowfall_cm":null,"snow_days":null,"ski_prob":null,"tmin_